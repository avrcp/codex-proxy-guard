// Version resource for the single executable. Numeric fields track the
// product version; the macros come from the CMake compile definitions.
#include <windows.h>

#define CPG_STRINGIZE(x) #x
#define CPG_STRINGIZE2(x) CPG_STRINGIZE(x)

#ifndef CPG_PRODUCT_VERSION
#define CPG_PRODUCT_VERSION "0.7.0-rc.3"
#endif
#ifndef CPG_BUILD_COMMIT
#define CPG_BUILD_COMMIT "unknown"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,0,0
 PRODUCTVERSION 0,7,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Codex Proxy Guard contributors"
            VALUE "FileDescription", "Codex Proxy Guard - local proxy launcher"
            VALUE "FileVersion", CPG_STRINGIZE2(0.7.0.0)
            VALUE "InternalName", "CodexProxyGuard"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "CodexProxyGuard.exe"
            VALUE "ProductName", "Codex Proxy Guard"
            VALUE "ProductVersion", CPG_PRODUCT_VERSION
            VALUE "BuildCommit", CPG_BUILD_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
